{
  "name": "facebook-archive-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Windows desktop application for exploring personal Facebook exports.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "cheerio": "^1.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "@types/yauzl": "^3.4.0"
  },
  "build": {
    "appId": "com.alkbany.facebookarchiveexplorer",
    "productName": "Facebook Archive Explorer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signExts": [
        ".dll",
        ".node",
        ".sys",
        ".ocx"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alkbany/facebook-archive-explorer.git"
  },
  "homepage": "https://github.com/Alkbany/facebook-archive-explorer#readme",
  "bugs": {
    "url": "https://github.com/Alkbany/facebook-archive-explorer/issues"
  },
  "author": {
    "name": "Ahmed Alkbany"
  }
}
